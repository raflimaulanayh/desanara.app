{
  "$schema": "https://turborepo.dev/schema.json",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "$TURBO_ROOT$/.env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["API_URL", "NEXT_PUBLIC_*", "API_PROXY_TARGET", "DESANARA_UI_PREVIEW", "VERCEL_ENV"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["WEB_API_URL", "DESANARA_UI_PREVIEW", "DESANARA_WEB_DEV_DIST_DIR"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^check-types"],
      "env": ["TEST_DATABASE_URL"],
      "outputs": []
    }
  },
  "ui": "tui"
}
