# Copy to .env (root). Every app/package reads the root .env in development.
# Never commit real secrets.

# --- Database (local Postgres or Supabase used as plain Postgres) ---
# Supabase: use a POOLER string (IPv4), never the direct db.<ref>.supabase.co host (IPv6 only on Free).
#   laptop / migrations / seed -> Session pooler     ...@aws-0-<region>.pooler.supabase.com:5432/postgres
#   API on Vercel              -> Transaction pooler ...@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/umkm_app
# Connections per API instance (use 1-3 on Vercel)
DB_POOL_MAX=10
# API integration tests (bun run --cwd apps/api test). Must be a LOCAL, migrated database; the tests
# refuse any other host. Leave empty to skip them. Never point this at Supabase.
TEST_DATABASE_URL=

# --- API (apps/api) ---
API_PORT=8787
# Public base URL of the API (used by Better Auth and the apps)
API_URL=http://localhost:8787
# Comma-separated origins allowed by CORS and Better Auth trustedOrigins
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001
# Login for /docs and /openapi.json. Empty: open locally, switched off when NODE_ENV=production.
DOCS_USERNAME=desanara
DOCS_PASSWORD=
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Public origin of /api/auth/* when the dashboard proxies the API (Vercel), e.g. https://dashboard.desanara.app
AUTH_BASE_URL=
# Parent domain for cross-subdomain cookies, e.g. desanara.app. Empty locally and in production today
# (the dashboard proxies the API, so its cookie is first-party).
COOKIE_DOMAIN=

# --- Cloudflare R2 (S3 compatible) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Cloudflare account HIMASIF. Bucket for public media; backups use the separate private bucket
# desanara-backups (never put backups in the public bucket).
R2_BUCKET=desanara-media
# Public base URL of the media bucket (R2 custom domain), e.g. https://cdn.desanara.app. Keys are stored, not URLs.
R2_PUBLIC_URL=

# --- Email (Resend, domain desanara.app) ---
# API key with "Sending access" only. Use a separate key per environment (laptop vs Vercel) so one can be revoked
# alone. Empty = emails (codes, invitations) are printed in the API console instead of sent.
RESEND_API_KEY=
EMAIL_FROM="Desanara <noreply@desanara.app>"
# Optional: where replies to Desanara emails go (e.g. the HIMASIF address).
EMAIL_REPLY_TO=
# Dashboard origin used in invitation links (production: https://dashboard.desanara.app).
DASHBOARD_URL=http://localhost:3001

# --- Seed (demo data) ---
# WhatsApp number (628xxx) used by every demo business, e.g. the HIMA team number.
SEED_WHATSAPP_NUMBER=
# Password for every demo account. Required for any non-local database (the built-in local default is public).
SEED_DEMO_PASSWORD=

# --- Frontend apps ---
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3001
# Dashboard on Vercel only: API origin to proxy /api/auth/* and /v1/* to (then NEXT_PUBLIC_API_URL = dashboard origin)
API_PROXY_TARGET=
# Base URL for stored media keys: the R2 public URL (e.g. https://cdn.desanara.app), same value as R2_PUBLIC_URL.
# Set on web AND dashboard (next/image allows this host). Empty = /media (apps/web/public/media, local only).
NEXT_PUBLIC_MEDIA_URL=
# Map tiles for the dashboard location pickers (Leaflet). Empty = OpenStreetMap's own tiles, fine for low traffic;
# set both to move to another provider (e.g. MapTiler, Stadia) when usage grows. {z}/{x}/{y} placeholders required.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=
