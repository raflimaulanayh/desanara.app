# Copy to .env (root). Every app/package reads the root .env in development.
# Never commit real secrets.

# --- Database (local Postgres or Supabase used as plain Postgres) ---
# Supabase: use a POOLER string (IPv4), never the direct db.<ref>.supabase.co host (IPv6 only on Free).
#   laptop / migrations / seed -> Session pooler     ...@aws-0-<region>.pooler.supabase.com:5432/postgres
#   API on Vercel              -> Transaction pooler ...@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/umkm_app
# Connections per API instance (use 1-3 on Vercel)
DB_POOL_MAX=10

# --- API (apps/api) ---
API_PORT=8787
# Public base URL of the API (used by Better Auth and the apps)
API_URL=http://localhost:8787
# Comma-separated origins allowed by CORS and Better Auth trustedOrigins
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Public origin of /api/auth/* when the dashboard proxies the API (Vercel), e.g. https://desanara-dashboard.vercel.app
AUTH_BASE_URL=
# Parent domain for cross-subdomain cookies in production, e.g. desanara.id (leave empty locally)
COOKIE_DOMAIN=

# --- Cloudflare R2 (S3 compatible) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=umkm-app
# Public custom domain serving the bucket, e.g. https://cdn.desanara.id
R2_PUBLIC_URL=

# --- Seed (demo data) ---
# WhatsApp number (628xxx) used by every demo business, e.g. the HIMA team number.
SEED_WHATSAPP_NUMBER=
# Password for every demo account. Required for any non-local database (the default demo12345 is public).
SEED_DEMO_PASSWORD=

# --- Frontend apps ---
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3001
# Dashboard on Vercel only: API origin to proxy /api/auth/* and /v1/* to (then NEXT_PUBLIC_API_URL = dashboard origin)
API_PROXY_TARGET=
# Base URL for stored media keys (R2 custom domain in production). Defaults to /media (apps/web/public/media).
NEXT_PUBLIC_MEDIA_URL=
