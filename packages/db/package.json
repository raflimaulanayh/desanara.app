{
  "name": "@repo/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "bun --env-file=../../.env run drizzle-kit migrate",
    "studio": "bun --env-file=../../.env run drizzle-kit studio",
    "seed": "bun --env-file=../../.env src/seed/index.ts",
    "seed:reset": "bun --env-file=../../.env src/seed/index.ts --reset",
    "lint": "eslint .",
    "check-types": "tsc --noEmit",
    "regions:import": "bun --env-file=../../.env src/regions/cli.ts",
    "regions:build": "bun src/regions/build-dataset.ts",
    "test": "bun test"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@types/bun": "1.4.4",
    "better-auth": "1.7.14",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "typescript": "6.0.3"
  }
}
